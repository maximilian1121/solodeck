{
  "name": "solodeck",
  "version": "1.0",
  "description": "Run a Spotify Connect receiver on your Steam Deck",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximilian1121/solodeck.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "spotify",
    "soloist"
  ],
  "author": "Maximilian1121",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/maximilian1121/solodeck/issues"
  },
  "homepage": "https://github.com/maximilian1121/solodeck#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
