[Desktop Entry]
Type=Application
Version=1.0
Name=Solodeck Install / Update
Comment=Install or update the Solodeck Spotify Connect Decky plugin (downloads latest from GitHub)
Exec=bash -c 'f="$(mktemp)"; curl -fsSL -o "$f" "https://raw.githubusercontent.com/maximilian1121/solodeck/main/install_solodeck.sh" && chmod +x "$f" && bash "$f"; rc=$?; rm -f "$f"; exit $rc'
Icon=spotify-client
Terminal=true
Categories=System;Settings;
StartupNotify=true
